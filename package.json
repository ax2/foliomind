{
  "name": "foliomind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "fetch:pi": "node scripts/fetch-pi-runtime.mjs",
    "fetch:bash": "node scripts/fetch-portable-git.mjs",
    "smoke:pi": "node scripts/smoke-pi-runtime.mjs",
    "desktop:dev": "npm run fetch:pi && npm run fetch:bash && tauri dev",
    "desktop:build": "npm run fetch:pi && npm run fetch:bash && tauri build",
    "test": "vitest run && node --test packages/qveris-bridge/index.test.mjs",
    "test:watch": "vitest",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@vitejs/plugin-react": "5.0.4",
    "lightweight-charts": "^5.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
